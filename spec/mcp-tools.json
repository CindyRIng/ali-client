  {
    "name": "ali_region_search",
    "description": "按中文/英文/拼音搜索地区",
    "inputSchema": {
      "type": "object",
      "properties": {
        "q": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "q"
      ],
      "$defs": {
        "RegionSearchQuery": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "q"
          ]
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": true
    }
