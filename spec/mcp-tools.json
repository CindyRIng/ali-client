  {
    "name": "ali_login",
    "description": "打开登录窗口（可选）；anonymous-first 下 v1 无需登录",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mode": {
          "default": "manual",
          "$ref": "#/$defs/LoginMode"
        }
      },
      "$defs": {
        "LoginStartRequest": {
          "type": "object",
          "properties": {
            "mode": {
              "default": "manual",
              "$ref": "#/$defs/LoginMode"
            }
          }
        },
        "LoginMode": {
          "type": "string",
          "enum": [
            "manual"
          ],
          "description": "v1 仅支持 manual（打开浏览器窗口人工登录一次）"
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "ali_login_status",
    "description": "查询登录状态",
    "inputSchema": {
      "type": "object",
      "properties": {
        "loginId": {
          "$ref": "#/$defs/LoginId"
        }
      },
      "required": [
        "loginId"
      ],
      "$defs": {
        "LoginStatusQuery": {
          "type": "object",
          "properties": {
            "loginId": {
              "$ref": "#/$defs/LoginId"
            }
          },
          "required": [
            "loginId"
          ]
        },
        "LoginId": {
          "type": "string",
          "pattern": "^login_[A-Za-z0-9_-]{8,64}$",
          "description": "登录流程 ID"
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "ali_login_cancel",
    "description": "取消登录流程",
