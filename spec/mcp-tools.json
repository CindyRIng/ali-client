      ],
      "$defs": {
        "LoginId": {
          "type": "string",
          "pattern": "^login_[A-Za-z0-9_-]{8,64}$",
          "description": "登录流程 ID"
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": true
    }
