    ],
    "additionalProperties": false,
    "$defs": {
      "CacheClearResult": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "object",
            "properties": {
              "queries": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "suppliers": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "details": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "factories": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "queries",
              "suppliers",
              "details",
