{
  "id": "cache.clear",
  "summary": "清缓存",
  "auth": "bearer",
  "rest": {
    "method": "DELETE",
    "path": "/v1/cache",
    "query": {
      "type": "object",
      "properties": {
        "kind": {
          "default": "all",
          "type": "string",
          "enum": [
            "all",
            "queries",
            "suppliers",
            "details",
            "factories"
          ]
        }
      },
      "$defs": {
        "CacheClearQuery": {
          "type": "object",
          "properties": {
            "kind": {
              "default": "all",
              "type": "string",
              "enum": [
                "all",
                "queries",
                "suppliers",
                "details",
                "factories"
              ]
            }
          }
        }
      }
    }
  },
  "cli": {
    "command": "cache clear",
    "description": "清缓存（--kind all|queries|suppliers|details|factories）",
    "example": "ali cache clear --kind details"
  },
  "mcp": {
    "name": "ali_cache_clear",
    "description": "清缓存：kind=all|queries|suppliers|details|factories"
  },
  "input": {
    "type": "object",
    "properties": {
      "kind": {
        "default": "all",
        "type": "string",
        "enum": [
          "all",
          "queries",
          "suppliers",
          "details",
          "factories"
        ]
      }
    },
    "$defs": {
      "CacheClearQuery": {
        "type": "object",
        "properties": {
          "kind": {
            "default": "all",
            "type": "string",
            "enum": [
              "all",
              "queries",
              "suppliers",
              "details",
              "factories"
            ]
          }
        }
      }
    }
  },
  "output": {
    "type": "object",
    "properties": {
      "deleted": {
        "type": "object",
        "properties": {
          "queries": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "suppliers": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "details": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "factories": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
