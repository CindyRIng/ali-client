{
  "id": "health.get",
  "summary": "健康检查",
  "auth": "none",
  "rest": {
    "method": "GET",
    "path": "/v1/health"
  },
  "cli": {
    "command": "health",
    "description": "健康检查",
    "example": "ali health"
  },
  "mcp": {
    "name": "ali_health",
    "description": "健康检查（进程存活）"
  },
  "input": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "service": {
        "type": "string",
        "const": "ali-client"
      },
      "status": {
        "type": "string",
        "const": "ok"
      },
      "version": {
        "type": "string"
      },
      "uptimeMs": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "service",
      "status",
      "version",
      "uptimeMs"
    ],
    "additionalProperties": false,
    "$defs": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "const": "ali-client"
          },
          "status": {
            "type": "string",
            "const": "ok"
          },
          "version": {
            "type": "string"
          },
          "uptimeMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "service",
          "status",
          "version",
          "uptimeMs"
        ],
        "additionalProperties": false
      }
    }
  }
}
