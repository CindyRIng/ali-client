            "type": "string",
            "description": "GB 行政区划代码风格：CN-13 / CN-13-1311"
          },
          "level": {
            "$ref": "#/$defs/RegionLevel"
          },
          "nameZh": {
            "type": "string"
          },
          "nameEn": {
            "type": "string",
