{
  "id": "suppliers.list",
  "summary": "按 queryId 翻页",
  "auth": "bearer",
  "rest": {
    "method": "GET",
    "path": "/v1/suppliers",
    "query": {
      "type": "object",
      "properties": {
        "queryId": {
          "$ref": "#/$defs/QueryId"
        },
        "page": {
          "default": 1,
          "description": "页码，从 1 开始",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "refresh": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          ]
        }
      },
      "required": [
        "queryId"
      ],
      "$defs": {
        "SuppliersListQuery": {
          "type": "object",
          "properties": {
            "queryId": {
              "$ref": "#/$defs/QueryId"
            },
            "page": {
              "default": 1,
              "description": "页码，从 1 开始",
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "refresh": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "enum": [
                    "true",
                    "false"
                  ]
                }
              ]
            }
          },
          "required": [
            "queryId"
          ]
        },
        "QueryId": {
          "type": "string",
          "pattern": "^q_[0-9a-f]{16}$",
          "description": "搜索查询 ID（q_ + sha256 前 16 位 hex）"
        }
      }
    }
  },
  "cli": {
    "command": "suppliers list",
    "description": "按 queryId 翻页",
    "example": "ali suppliers list --query-id q_xxx --page 2"
  },
  "mcp": {
