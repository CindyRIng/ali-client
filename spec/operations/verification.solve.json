            "to": {
              "description": "drag 模式终点 [x,y]",
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "durationMs": {
              "default": 900,
              "type": "integer",
              "minimum": 100,
              "maximum": 10000
            }
          }
        }
      }
    }
  },
  "cli": {
    "command": "verify solve",
    "description": "自动过滑块（--mode auto）或坐标中继（--mode drag --from x,y --to x,y）",
    "example": "ali verify solve --mode auto"
  },
  "mcp": {
