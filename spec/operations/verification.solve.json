{
  "id": "verification.solve",
  "summary": "自动/坐标中继过滑块验证",
  "auth": "bearer",
  "rest": {
    "method": "POST",
    "path": "/v1/verification/solve",
    "body": {
      "type": "object",
      "properties": {
        "mode": {
          "default": "auto",
          "type": "string",
          "enum": [
            "auto",
            "drag"
          ]
        },
        "from": {
          "description": "drag 模式起点 [x,y]",
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "to": {
          "description": "drag 模式终点 [x,y]",
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "durationMs": {
          "default": 900,
          "type": "integer",
          "minimum": 100,
          "maximum": 10000
        }
      },
      "$defs": {
        "VerificationSolveRequest": {
          "type": "object",
          "properties": {
            "mode": {
              "default": "auto",
              "type": "string",
              "enum": [
