{
  "id": "regions.search",
  "summary": "地区搜索（中文/英文/拼音）",
  "auth": "bearer",
  "rest": {
    "method": "GET",
    "path": "/v1/regions/search",
    "query": {
      "type": "object",
      "properties": {
        "q": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "q"
      ],
      "$defs": {
        "RegionSearchQuery": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "q"
          ]
        }
      }
    }
  },
  "cli": {
    "command": "regions search",
    "description": "按中文/英文/拼音搜索地区",
    "example": "ali regions search 衡水"
  },
  "mcp": {
    "name": "ali_region_search",
    "description": "按中文/英文/拼音搜索地区"
  },
  "input": {
    "type": "object",
    "properties": {
      "q": {
        "type": "string",
        "minLength": 1
      },
      "limit": {
        "default": 20,
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      }
    },
    "required": [
      "q"
    ],
    "$defs": {
      "RegionSearchQuery": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "q"
        ]
      }
    }
  },
  "output": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string"
      },
      "items": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Region"
        }
      },
      "count": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "query",
      "items",
      "count"
    ],
    "additionalProperties": false,
    "$defs": {
      "RegionSearchResponse": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Region"
            }
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "query",
          "items",
          "count"
        ],
        "additionalProperties": false
      },
      "Region": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "GB 行政区划代码风格：CN-13 / CN-13-1311"
          },
          "level": {
            "$ref": "#/$defs/RegionLevel"
          },
          "nameZh": {
            "type": "string"
          },
          "nameEn": {
            "type": "string",
            "description": "英文展示名（阿里页面口径，如 Hebei / Hengshui）"
          },
          "pinyin": {
            "type": "string"
          },
          "aliases": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "aliSpellings": {
            "default": [],
            "description": "在阿里页面上出现过的拼写（含噪声拼写映射）",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parentCode": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "level",
          "nameZh",
          "nameEn",
          "pinyin",
          "aliases",
          "aliSpellings",
          "parentCode"
        ],
        "additionalProperties": false
      },
      "RegionLevel": {
        "type": "string",
        "enum": [
          "province",
          "city"
        ]
      }
    }
  }
}
