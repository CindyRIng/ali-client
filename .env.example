# ali-client 运行配置（复制为 .env 后修改；优先级：CLI > env > .env > 默认值）

# ── REST / MCP ───────────────────────────────────────────────
# 必填：REST Bearer token（建议 openssl/node 随机生成）
ALI_API_TOKEN=change-me
ALI_HOST=127.0.0.1
ALI_PORT=8792
# 可选：CLI/MCP 连接已有常驻服务的地址（默认自动探测本机 8792）
# ALI_API_URL=http://127.0.0.1:8792
# 可选：显式指定 .env 路径（默认 cwd/.env → 仓库根 .env）
# ALI_ENV_FILE=/home/songqian/ali-client/.env

# ── 数据目录与浏览器 ─────────────────────────────────────────
ALI_DATA_DIR=~/.ali-client
ALI_PROFILE_DIR=~/.ali-client/profile
# 本机有桌面时建议 headful（风控更低）；无显示环境可设 true（需自行处理验证码中继）
ALI_HEADLESS=false
ALI_HUMANIZE=true
ALI_LOCALE=en-US
ALI_TIMEZONE=Asia/Shanghai
ALI_VIEWPORT_WIDTH=1920
ALI_VIEWPORT_HEIGHT=1080

# ── 上游站点 ─────────────────────────────────────────────────
ALI_BASE_URL=https://www.alibaba.com
ALI_SEARCH_URL=https://www.alibaba.com/trade/search
ALI_FACTORY_API_URL=https://insights.alibaba.com/openservice/gatewayService
ALI_LANG=en-US
ALI_CURRENCY=USD
ALI_COUNTRY=CN

# ── 采集 / 限频 / 风控 ───────────────────────────────────────
ALI_MAX_PAGES=5
ALI_PAGE_INTERVAL_MS=10000
ALI_FETCH_INTERVAL_MS=900
ALI_FETCH_JITTER_MS=500
ALI_DETAIL_CONCURRENCY=2
ALI_DETAIL_INTERVAL_MS=700
ALI_MAX_ENRICH=60
ALI_WATCHDOG_MS=18000
ALI_REQUEST_TIMEOUT_MS=30000
ALI_COOLDOWN_S=60
ALI_COOLDOWN_MAX_S=900
ALI_VERIFICATION_TTL_SEC=600
ALI_VERIFICATION_ATTEMPTS=3
ALI_X5SEC_REFRESH_BEFORE_S=180
ALI_FETCH_BUDGET_PER_10MIN=240
ALI_WORKER_REFRESH_EVERY=200
ALI_LOGIN_TIMEOUT_SEC=600
# 可选：登录页地址（登录取自 upstream，一般不用改）
# ALI_LOGIN_URL=https://login.alibaba.com/newlogin/icbuLogin.htm?return_url=https%3A%2F%2Fwww.alibaba.com
# 可选：owner 单实例锁文件（默认 ~/.ali-client/ali-client.lock）
# ALI_LOCK_FILE=~/.ali-client/run/ali.lock
# CLI/MCP 调用 REST 的超时（strict 回填 60 家可能耗时 60-90s）
ALI_CLIENT_TIMEOUT_MS=180000

# ── 缓存 ─────────────────────────────────────────────────────
ALI_CACHE_DB=~/.ali-client/cache.sqlite
ALI_CACHE_DRIVER=sqlite
ALI_TTL_SEARCH_S=7200
ALI_TTL_DETAIL_S=604800
ALI_TTL_FACTORY_S=86400
ALI_CACHE_MAX_BYTES=209715200

# ── 日志 ─────────────────────────────────────────────────────
ALI_LOG_LEVEL=info
ALI_LOG_FILE=~/.ali-client/logs/ali.log
ALI_LOG_MAX_BYTES=10485760
ALI_LOG_KEEP=5
ALI_LOG_STDOUT=true
