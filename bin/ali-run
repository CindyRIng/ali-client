#!/usr/bin/env bash
# 在共享 cloak 环境（FHS + Chromium）中运行 ali-client 命令
# 用法: bin/ali-run <command> [args...]（可在任意目录运行；默认加载仓库 .env）
set -euo pipefail
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
CLOAK_ENV="${CLOAK_ENV:-$HOME/cloak-env}"
# 无论当前目录在哪，都优先使用仓库 .env（显式设置 ALI_ENV_FILE 可覆盖）
if [ -z "${ALI_ENV_FILE:-}" ] && [ -f "$ROOT/.env" ]; then
  export ALI_ENV_FILE="$ROOT/.env"
fi
exec "$CLOAK_ENV/bin/cloak-run" node "$ROOT/dist/main.js" "$@"
